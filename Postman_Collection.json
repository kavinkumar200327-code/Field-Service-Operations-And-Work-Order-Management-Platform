{
  "info": {
    "_postman_id": "c1f7b539-74d1-447b-b892-servisync001",
    "name": "Field Service Operations & Work Order Management Platform (ServiSync)",
    "description": "Comprehensive API collection for Field Service Operations with JWT Authentication, RBAC, Scheduling, Parts Inventory, Job Execution, and PDF Reports.",
