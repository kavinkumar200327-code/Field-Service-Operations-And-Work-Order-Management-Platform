# ==============================================================================
# ServiSync Pro - Frontend Environment Variables (.env.example)
# Copy this file to Frontend/.env for custom Vite development or production builds
# ==============================================================================

# Backend REST API Base URL
VITE_API_BASE_URL=http://localhost:8000/api

# WebSocket Server Endpoint for Real-Time Dispatch & System Notifications
VITE_WS_URL=ws://localhost:8000/api/notifications/ws

# App Port (Default: 3000 / 5173)
PORT=3000
