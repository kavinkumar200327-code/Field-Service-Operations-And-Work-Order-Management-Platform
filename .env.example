# ==============================================================================
# ServiSync Pro - Universal Environment Variables (.env.example)
# Copy this file to .env in the project root or configure Backend/.env and Frontend/.env
# ==============================================================================

# --- Application Metadata ---
PROJECT_NAME="Field Service Operations & Work Order Management Platform"
ENVIRONMENT="development"
DEBUG=True

# --- Backend API & Security Configuration ---
API_V1_STR="/api"
SECRET_KEY="super-secret-jwt-key-for-development-change-in-production-min32chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database Connection URLs ---
# Local PostgreSQL Default
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/field_service_ops"
TEST_DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/field_service_ops_test"

# Docker Compose PostgreSQL (when running via docker-compose)
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@postgres:5432/field_service_ops"

# --- File Storage & Uploads ---
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=10

# --- CORS & Network ---
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# --- Frontend Client Configuration ---
VITE_API_BASE_URL="http://localhost:8000/api"
VITE_WS_URL="ws://localhost:8000/api/notifications/ws"
